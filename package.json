{
    "name": "btdb2server",
    "version": "1.0.0",
    "description": "REST API server for BTD Battles 2 data",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "start": "bun run src/index.ts",
