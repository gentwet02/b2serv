{
    "name": "btdb2server",
    "version": "1.0.0",
    "description": "REST API server for BTD Battles 2 data",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir ./dist --target bun",
        "type-check": "bunx tsc --noEmit"
    },
    "dependencies": {
        "hono": "^4.9.2",
        "mongodb": "^6.18.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^24.3.0"
    },
