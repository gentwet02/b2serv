# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/battles2
MONGODB_LOCAL=mongodb://127.0.0.1:27017/btd

# Ninja Kiwi API
NK_REQUESTS_PER_SECOND=3
NK_FETCH_RETRIES=5
# live leaderboard refresh (ms)
NK_FETCH_INTERVAL=300000
# pause between two full match crawls, counted from the end of the previous one (ms)
NK_MATCHES_INTERVAL=900000

# CORS
CLIENT_URL=http://localhost:5173
