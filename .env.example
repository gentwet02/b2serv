# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/battles2
MONGODB_LOCAL=mongodb://127.0.0.1:27017/btd

# Ninja Kiwi API
# NK (Cloudflare) blocks an IP for 60s past ~100 requests a minute: both caps apply
NK_REQUESTS_PER_SECOND=1.5
NK_REQUESTS_PER_MINUTE=90
NK_FETCH_RETRIES=5
# live leaderboard refresh (ms)
NK_FETCH_INTERVAL=300000

# CORS
CLIENT_URL=http://localhost:5173
